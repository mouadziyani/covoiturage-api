              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "trips",
                "search"
              ],
              "query": [
                {
                  "key": "departureCity",
                  "value": "Casablanca"
                },
                {
                  "key": "arrivalCity",
                  "value": "Tangier"
                },
                {
                  "key": "date",
                  "value": "{{searchDate}}"
                },
                {
                  "key": "seats",
                  "value": "1"
                },
                {
                  "key": "maxPrice",
                  "value": "150"
                },
                {
                  "key": "page",
                  "value": "0"
                },
                {
