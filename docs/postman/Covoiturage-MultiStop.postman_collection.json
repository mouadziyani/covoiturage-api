            ],
            "url": {
              "raw": "{{baseUrl}}/api/drivers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "drivers"
              ]
            },
            "description": "Crée un conducteur. Email et numéro de permis uniques. Sauvegarde `driverId`, `driverEmail`, `driverLicense`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Youssef\",\n  \"lastName\": \"Benali\",\n  \"email\": \"driver.{{$timestamp}}@example.com\",\n  \"phoneNumber\": \"0612345678\",\n  \"drivingLicenseNumber\": \"LIC-{{$timestamp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('driverId', j.id);",
                  "pm.collectionVariables.set('driverLastName', j.lastName);",
                  "pm.collectionVariables.set('driverEmail', j.email);",
                  "pm.collectionVariables.set('driverLicense', j.drivingLicenseNumber);"
