    {
      "name": "4 - Trips",
      "item": [
        {
          "name": "Publish trip",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/trips",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "trips"
              ]
            },
            "description": "Publie un trajet multi-étapes. Règles : au moins 2 points, villes uniques, prix du 1er point = 0, heures et prix strictement croissants, départ dans le futur, `proposedSeats` <= capacité, véhicule du conducteur. Sauvegarde `tripId` et `stopId1`..`stopId4` (ordre du parcours).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"driverId\": {{driverId}},\n  \"carId\": {{carId}},\n  \"proposedSeats\": 3,\n  \"stopPoints\": [\n    {\n      \"city\": \"Casablanca\",\n      \"stopOrder\": 0,\n      \"passageTime\": \"{{stop1}}\",\n      \"priceFromDeparture\": 0\n    },\n    {\n      \"city\": \"Rabat\",\n      \"stopOrder\": 1,\n      \"passageTime\": \"{{stop2}}\",\n      \"priceFromDeparture\": 40\n    },\n    {\n      \"city\": \"Kenitra\",\n      \"stopOrder\": 2,\n      \"passageTime\": \"{{stop3}}\",\n      \"priceFromDeparture\": 65\n    },\n    {\n      \"city\": \"Tangier\",\n      \"stopOrder\": 3,\n      \"passageTime\": \"{{stop4}}\",\n      \"priceFromDeparture\": 120\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('tripId', j.id);",
                  "(j.stopPoints || []).forEach((s, i) => pm.collectionVariables.set('stopId' + (i + 1), s.id));",
                  "pm.test('Trip is PUBLIE', () => pm.expect(j.status).to.eql('PUBLIE'));",
                  "pm.test('3 remaining seats', () => pm.expect(j.remainingSeats).to.eql(3));"
                ]
              }
            }
          ]
        },
