    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Heures de passage futures et strictement croissantes (format LocalDateTime, heure locale).",
          "const pad = n => String(n).padStart(2, '0');",
          "const fmt = d => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}:00`;",
          "const base = new Date();",
          "base.setDate(base.getDate() + 3);",
          "base.setHours(8, 0, 0, 0);",
          "const at = h => fmt(new Date(base.getTime() + h * 3600 * 1000));",
          "pm.collectionVariables.set('stop1', at(0));",
          "pm.collectionVariables.set('stop2', at(1.5));",
          "pm.collectionVariables.set('stop3', at(2.5));",
          "pm.collectionVariables.set('stop4', at(4.5));",
          "pm.collectionVariables.set('searchDate', fmt(base).substring(0, 10));"
        ]
      }
    }
